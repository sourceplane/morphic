# Local development. Copy to .env.local (git-ignored); never commit a value.
#
# DATABASE_URL is read by drizzle-kit and by `pnpm --filter @app/web migrate`
# (which applies drizzle/ to a local Postgres), and by the app only when no
# Cloudflare context is available. Under `next dev` and `wrangler dev` the app
# reads the HYPERDRIVE binding from wrangler.jsonc instead (its
# localConnectionString — point both at the same database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/morphic
DATABASE_SSL_DISABLED=true
# The site's public origin (the page's canonical and Open Graph links). The
# Orun build sets it per environment (component.yaml); unset, it is
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
